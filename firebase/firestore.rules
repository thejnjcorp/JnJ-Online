rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if uid() == "wmJQbIlzX9RydXFmh3DzSBpIqHa2";
    }

    match /players/{userId} {
    	allow read, write: if isSignedIn() && uid() == userId;

      allow read: if isSignedIn();
    }

    match /campaigns/{campaignId} {
    	allow read: if isSignedIn() && uid() in canReadField();

      allow read, write: if isSignedIn() && uid() in canWriteField();

      allow read, write: if isSignedIn() && uid() == resource.data.director_uid;

      allow create: if isSignedIn() && !documentExists("campaigns", campaignId);
    }

    match /characters/{characterId} {
    	allow read, write: if isSignedIn() && uid() == resource.data.playerId;

      allow read: if isSignedIn() && uid() in canReadField();

      allow read: if isSignedIn() && inCampaign();

      allow read, write: if isSignedIn() && uid() in canWriteField();

      allow create: if isSignedIn() && !documentExists("characters", characterId);
    }

    match /classes/{classId} {
    	allow read: if isSignedIn();

    	allow read, write: if isSignedIn() && uid() in canWriteField();

      allow create: if isSignedIn() && !documentExists("classes", classId);
    }

    match /races/{raceId} {
    	allow read: if isSignedIn();

      allow read, write: if isSignedIn() && uid() in canWriteField();

      allow create: if isSignedIn() && !documentExists("races", raceId);
    }

    match /maps/{mapId} {
    	allow read: if isSignedIn();

      allow read, write: if isSignedIn() && uid() in canWriteField();

      allow create: if isSignedIn() && !documentExists("maps", mapId);
    }

    // A status is public (readable by anyone signed in), or locked down via
    // canRead - same array-of-uids pattern as campaigns/characters above,
    // not a live campaign membership lookup. Locking to a campaign works by
    // the client copying that campaign's current canRead+canWrite into this
    // status's canRead at save time (see StatusPage.js) - a snapshot, not a
    // join, matching how this app already denormalizes everything else
    // (class actions onto characters, status presets onto characters, etc).
    // Deliberately avoids get()/exists() here: a rule with a cross-document
    // lookup can make a broad `list` query over this collection unprovable
    // and get rejected outright, not just filter out documents you can't
    // read - see StatusListPage.js/AddStatusDialog.js, which query this
    // collection with plain equality/array-contains filters for exactly
    // that reason.
    // `isDefault` (an admin-curated status everyone gets automatically, no
    // subscription needed) can only ever be true on a doc the admin account
    // wrote - checked on both create and every subsequent update, since a
    // non-admin author who already has canWrite on their own status could
    // otherwise just flip isDefault themselves later. Everyone else's
    // statuses are the "pool": still `public` (readable/browsable by any
    // signed-in user, same as before), but a campaign has to separately
    // subscribe (campaigns.subscribedStatusIds, written under the existing
    // campaign write rules - no change needed there) before that pool
    // status is offered as a preset for that campaign's characters - see
    // AddStatusDialog.js.
    match /statuses/{statusId} {
    	allow read: if isSignedIn() && (resource.data.public == true || uid() in canWriteField() || uid() in canReadField());

      allow write: if isSignedIn() && uid() in canWriteField() && (!('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());

      allow create: if isSignedIn() && !documentExists("statuses", statusId) && (!('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());
    }

    // Functions \\

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
    	return request.auth.uid;
    }

    function isAdmin() {
    	return uid() == "wmJQbIlzX9RydXFmh3DzSBpIqHa2";
    }

    function canWriteField() {
    	return resource.data.canWrite;
    }

    function canReadField() {
    	return resource.data.canRead;
    }

    function documentExists(docName, documentId) {
    	return exists(/databases/$(database)/documents/$(docName)/$(documentId));
    }

    function inCampaign() {
    	let campaign = get(/databases/$(database)/documents/campaigns/$(resource.data.campaign));
      return uid() in campaign.data.canRead || uid() in campaign.data.canWrite;
    }
  }
}
