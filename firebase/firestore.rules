rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if uid() == "wmJQbIlzX9RydXFmh3DzSBpIqHa2";
    }

    match /players/{userId} {
    	allow read, write: if isSignedIn() && uid() == userId;

      allow read: if isSignedIn();
    }

    match /campaigns/{campaignId} {
    	allow read: if isSignedIn() && uid() in canReadField();

      allow read, write: if isSignedIn() && uid() in canWriteField() && permissionFieldsUnchanged() && archiveFieldsUnchanged();

      allow read, write: if isSignedIn() && uid() == resource.data.director_uid && archiveFieldsUnchanged();

      allow read, write: if isSignedIn() && isDocAdmin();

      allow create: if isSignedIn() && !documentExists("campaigns", campaignId)
        && isCreatorDocAdmin() && request.resource.data.director_uid == uid();
    }

    match /characters/{characterId} {
    	allow read, write: if isSignedIn() && uid() == resource.data.playerId;

      allow read: if isSignedIn() && uid() in canReadField();

      allow read: if isSignedIn() && inCampaign();

      allow read, write: if isSignedIn() && uid() in canWriteField() && permissionFieldsUnchanged();

      allow read, write: if isSignedIn() && isDocAdmin();

      allow create: if isSignedIn() && !documentExists("characters", characterId)
        && isCreatorDocAdmin() && request.resource.data.playerId == uid();
    }

    // Same three-tier model as statuses above (public/isDefault/canRead,
    // isDefault admin-gated on every write, no cross-document get()/exists()
    // so a plain equality/array-contains list query stays provable - see
    // ClassListPage.js/NewCharacterPage.js) minus the campaign-lock tier: a
    // class doc doesn't currently offer authoring one scoped to a single
    // campaign from the start, only Default (isDefault, admin-curated, every
    // campaign gets it automatically), Pool (public, a campaign has to
    // subscribe via campaigns.subscribedClassIds - written under the
    // existing campaign write rules, no change needed there - before it's
    // offered in that campaign's class picker), and Private (canRead only).
    match /classes/{classId} {
    	allow read: if isSignedIn() && (resource.data.public == true || uid() in canWriteField() || uid() in canReadField());

      // request.resource is null on a delete (there's no new document being
      // written) - `request.resource == null` first so a delete short-
      // circuits past the isDefault guard instead of throwing on
      // request.resource.data of a null resource. Found by hand while
      // manually deleting a test status through this exact rule shape - see
      // the identical fix on the statuses block below, which had the same
      // latent bug (StatusPage.js's delete button would have hit this too).
      allow write: if isSignedIn() && uid() in canWriteField() && permissionFieldsUnchanged()
        && (request.resource == null || !('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());

      allow write: if isSignedIn() && isDocAdmin()
        && (request.resource == null || !('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());

      allow create: if isSignedIn() && !documentExists("classes", classId) && isCreatorDocAdmin()
        && (!('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());
    }

    match /races/{raceId} {
    	allow read: if isSignedIn();

      allow read, write: if isSignedIn() && uid() in canWriteField() && permissionFieldsUnchanged();

      allow read, write: if isSignedIn() && isDocAdmin();

      allow create: if isSignedIn() && !documentExists("races", raceId) && isCreatorDocAdmin();
    }

    match /maps/{mapId} {
    	allow read: if isSignedIn();

      allow read, write: if isSignedIn() && uid() in canWriteField() && permissionFieldsUnchanged();

      allow read, write: if isSignedIn() && isDocAdmin();

      allow create: if isSignedIn() && !documentExists("maps", mapId) && isCreatorDocAdmin();
    }

    // A status is public (readable by anyone signed in), or locked down via
    // canRead - same array-of-uids pattern as campaigns/characters above,
    // not a live campaign membership lookup. Locking to a campaign works by
    // the client copying that campaign's current canRead+canWrite into this
    // status's canRead at save time (see StatusPage.js) - a snapshot, not a
    // join, matching how this app already denormalizes everything else
    // (class actions onto characters, status presets onto characters, etc).
    // Deliberately avoids get()/exists() here: a rule with a cross-document
    // lookup can make a broad `list` query over this collection unprovable
    // and get rejected outright, not just filter out documents you can't
    // read - see StatusListPage.js/AddStatusDialog.js, which query this
    // collection with plain equality/array-contains filters for exactly
    // that reason.
    // `isDefault` (an admin-curated status everyone gets automatically, no
    // subscription needed) can only ever be true on a doc the admin account
    // wrote - checked on both create and every subsequent update, since a
    // non-admin author who already has canWrite on their own status could
    // otherwise just flip isDefault themselves later. Everyone else's
    // statuses are the "pool": still `public` (readable/browsable by any
    // signed-in user, same as before), but a campaign has to separately
    // subscribe (campaigns.subscribedStatusIds, written under the existing
    // campaign write rules - no change needed there) before that pool
    // status is offered as a preset for that campaign's characters - see
    // AddStatusDialog.js.
    match /statuses/{statusId} {
    	allow read: if isSignedIn() && (resource.data.public == true || uid() in canWriteField() || uid() in canReadField());

      // request.resource is null on a delete (no new document being
      // written) - `request.resource == null` first so a delete
      // short-circuits past the isDefault guard instead of throwing on
      // .data of a null resource. StatusPage.js's delete button would hit
      // this on any status - found by hand while cleaning up a test status
      // through this exact path.
      allow write: if isSignedIn() && uid() in canWriteField() && permissionFieldsUnchanged()
        && (request.resource == null || !('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());

      allow write: if isSignedIn() && isDocAdmin()
        && (request.resource == null || !('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());

      allow create: if isSignedIn() && !documentExists("statuses", statusId) && isCreatorDocAdmin()
        && (!('isDefault' in request.resource.data) || request.resource.data.isDefault != true || isAdmin());
    }

    // Functions \\

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
    	return request.auth.uid;
    }

    // The single app-wide admin account (see ADMIN_UIDS in
    // src/utils/statusEffects.js) - distinct from isDocAdmin() below, which
    // is per-document and settable by any user who creates one.
    function isAdmin() {
    	return uid() == "wmJQbIlzX9RydXFmh3DzSBpIqHa2";
    }

    function canWriteField() {
    	return resource.data.canWrite;
    }

    function canReadField() {
    	return resource.data.canRead;
    }

    // A document's own admins - always granted full read/write on that
    // document (including changing canRead/canWrite/admins itself), unlike
    // a plain canWrite collaborator (see permissionFieldsUnchanged() below).
    // Every create sets this to (at least) the creator - see
    // isCreatorDocAdmin() - so every new document always has at least one
    // admin able to manage it later. Legacy documents predating this field
    // simply have no doc-admins (resource.data.get('admins', []) is empty)
    // until someone with write access saves them forward with one; their
    // existing owner-style grants (director_uid, playerId, canWrite) keep
    // working exactly as before in the meantime.
    function isDocAdmin() {
      return uid() in resource.data.get('admins', []);
    }

    function isCreatorDocAdmin() {
      return uid() in request.resource.data.get('admins', []);
    }

    // A plain canWrite collaborator (someone who isn't this document's
    // owner/admin) can freely edit its regular content, but not who else
    // can read, write, or administer it - otherwise any collaborator could
    // silently grant themselves (or anyone else) broader access than they
    // were actually given. True on a delete (request.resource == null,
    // nothing to compare) since deletion is already gated by canWrite alone,
    // same as before this field existed.
    function permissionFieldsUnchanged() {
      return request.resource == null
        || (request.resource.data.get('canRead', null) == resource.data.get('canRead', null)
          && request.resource.data.get('canWrite', null) == resource.data.get('canWrite', null)
          && request.resource.data.get('admins', null) == resource.data.get('admins', null));
    }

    // Only a document's admin can archive/unarchive a campaign or schedule/
    // cancel its deletion (see CampaignPage.js's Danger Zone) - a plain
    // canWrite collaborator or even the campaign's own director can still
    // edit everything else about it. True on a delete for the same reason
    // permissionFieldsUnchanged() is - deletion is already gated by
    // canWrite/director_uid alone, unrelated to these fields.
    function archiveFieldsUnchanged() {
      return request.resource == null
        || (request.resource.data.get('archived', null) == resource.data.get('archived', null)
          && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
          && request.resource.data.get('scheduledDeletionAt', null) == resource.data.get('scheduledDeletionAt', null));
    }

    function documentExists(docName, documentId) {
    	return exists(/databases/$(database)/documents/$(docName)/$(documentId));
    }

    function inCampaign() {
    	let campaign = get(/databases/$(database)/documents/campaigns/$(resource.data.campaign));
      return uid() in campaign.data.canRead || uid() in campaign.data.canWrite;
    }
  }
}
