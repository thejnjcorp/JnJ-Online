{
  "homepage": "https://thejnjcorp.github.io/JnJ-Online",
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@maxim_mazurok/gapi.client.drive-v3": "^0.0.20250210",
    "@mui/material": "^7.1.1",
    "@react-oauth/google": "^0.12.1",
    "@reduxjs/toolkit": "^2.3.0",
    "@tanstack/react-query": "^5.80.5",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.sheets-v4": "^0.0.4",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "enzyme": "^3.11.0",
    "firebase": "^11.3.1",
    "google-api-javascript-client": "^0.1.0",
    "google-spreadsheet": "^4.1.4",
    "lodash": "^4.17.21",
    "markdown-to-jsx": "^7.6.0",
    "react": "^18.3.1",
    "react-admin": "^5.8.3",
    "react-collapsible": "^2.10.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "react-router-dom": "^7.18.2",
    "react-textarea-autosize": "^8.5.9",
    "react-tooltip": "^5.28.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:tst": "jest --config jest.config.js",
    "test:tst:watch": "jest --config jest.config.js --watch",
    "test:tst:coverage": "jest --config jest.config.js --coverage",
    "eject": "react-scripts eject",
    "postinstall": "patch-package",
    "firebase:emulators": "firebase emulators:start --config firebase/firebase.json --project jnj-online",
    "firebase:test:rules": "firebase emulators:exec --only firestore --config firebase/firebase.json --project jnj-online \"node firebase/test/firestore.rules.test.js\"",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --config firebase/firebase.json --project jnj-online",
    "firebase:purge:test": "firebase emulators:exec --only firestore --config firebase/firebase.json --project jnj-online \"node firebase/test/purge-campaigns.test.js\"",
    "firebase:purge": "node firebase/scripts/purge-campaigns.js",
    "sonar": "bash scripts/sonar-scan.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/react": "^13.4.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "gh-pages": "^6.2.0",
    "patch-package": "^8.0.1",
    "react-scripts": "^5.0.1",
    "sass": "^1.83.0"
  },
  "overrides": {
    "sass-loader": "^16.0.8",
    "@svgr/webpack": "^8.1.0",
    "postcss": "^8.5.26",
    "serialize-javascript": "^7.1.0",
    "underscore": "^1.13.8",
    "sockjs": "^0.3.24",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^6.0.0",
    "jsdom": "^20.0.0"
  }
}
